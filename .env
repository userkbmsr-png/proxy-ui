# Domeniul paginii (creeaza un A record spre IP-ul public al serverului)
PROXYUI_DOMAIN=proxy.beba.work.gd

PROXYUI_USER=admin
# Minim 12 caractere. Generează una: openssl rand -base64 18
PROXYUI_PASSWORD=123412341234

# Recomandat: domeniul panoului WPL7 (nu poate fi acoperit de o ruta) si IP-ul public al
# serverului (pagina verifica daca DNS-ul unui domeniu indica spre el).
PANEL_DOMAIN=beba.work.gd
PUBLIC_IP=86.35.239.80

# Doar daca ai schimbat in WPL7 calea de baza sau resolver-ul ACME
SRV_ROOT=/srv
ACME_RESOLVER=letsencrypt
